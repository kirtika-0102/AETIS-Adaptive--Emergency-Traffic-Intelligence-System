# Copy to .env.local. Never commit .env.local.
# Everything starting with VITE_ is visible to anyone who opens the site,
# so never put a secret in here.

# true = run on built-in demo data (development only, ignored in production builds)
VITE_USE_MOCK_DATA=true

# Backend addresses. Relative paths are forwarded by the dev proxy in vite.config.ts.
VITE_API_BASE_URL=/api
VITE_WS_URL=/ws
VITE_DEV_PROXY_TARGET=http://localhost:8080

# Map (centre of the map when nothing is selected)
VITE_MAP_API_KEY=
VITE_MAP_DEFAULT_LAT=28.66
VITE_MAP_DEFAULT_LNG=77.38

VITE_APP_ENV=development